{
  "name": "oh-my-cli",
  "version": "1.0.0",
  "type": "module",
  "description": "命令行工具",
  "main": "dist/index.js",
  "bin": {
    "oh-my-cli": "./dist/index.js"
  },
  "scripts": {
    "start": "tsx bin/index.ts",
    "build": "tsup && cp package.json dist/",
    "start:docs": "cd website && yarn start",
    "build:docs": "cd website && yarn build",
    "deploy:docs": "cd website && yarn deploy",
    "clear:docs": "cd website && yarn clear",
    "serve:docs": "cd website && yarn serve",
    "check": "tsc --noEmit",
    "push": "npm publish",
    "lint": "eslint .",
    "fix": "eslint . --fix && prettier --write .",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "archiver": "^3.1.1",
    "camelcase": "^5.3.1",
    "chalk": "^3.0.0",
    "clui": "^0.3.6",
    "commander": "^5.0.0",
    "cross-spawn": "^7.0.1",
    "del": "^5.1.0",
    "fs-extra": "^9.0.0",
    "inquirer": "^7.1.0",
    "uuid": "^7.0.2",
    "yargs": "^15.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.0",
    "@commitlint/config-conventional": "^20.3.0",
    "@types/archiver": "^7.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.9",
    "@types/minimatch": "^5.1.2",
    "@types/node": "^25.0.3",
    "@types/yargs": "^17.0.35",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "pretty-quick": "^4.2.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
