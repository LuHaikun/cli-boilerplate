{
  "name": "oh-my-cli",
  "version": "1.0.0",
  "type": "module",
  "description": "命令行工具",
  "main": "dist/index.js",
  "bin": {
    "oh-my-cli": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx bin/index.ts",
    "start": "yarn dev",
    "build": "tsup",
    "start:docs": "cd website && yarn start",
    "build:docs": "cd website && yarn build",
    "deploy:docs": "cd website && yarn deploy",
    "clear:docs": "cd website && yarn clear",
    "serve:docs": "cd website && yarn serve",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "fix": "eslint . --fix && prettier --write .",
    "prepublishOnly": "yarn check && yarn lint && yarn test && yarn build",
    "push": "npm publish",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "chalk": "^5.6.2",
    "clui": "^0.3.6",
    "commander": "^13.1.0",
    "fs-extra": "^11.3.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.0",
    "@commitlint/config-conventional": "^20.3.0",
    "@types/archiver": "^7.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.9",
    "@types/minimatch": "^5.1.2",
    "@types/node": "^25.0.3",
    "@types/yargs": "^17.0.35",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "pretty-quick": "^4.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "vitest": "^3.2.4"
  },
  "resolutions": {
    "vite": "^6.4.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
