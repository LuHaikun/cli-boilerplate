{
  "name": "cec-cli",
  "version": "1.0.0",
  "type": "module",
  "description": "部署命令行工具",
  "main": "index.js",
  "bin": {
    "cec-cli": "./bin/index.js"
  },
  "scripts": {
    "start": "cd website && yarn start",
    "build": "cd website && yarn build",
    "swizzle": "cd website && yarn swizzle",
    "deploy:docs": "cd website && yarn deploy",
    "clear": "cd website && yarn clear",
    "serve": "cd website && yarn serve",
    "push": "npm publish",
    "standard": "standard --fix",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "standard": {
    "parser": "babel-eslint"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.0",
    "@commitlint/config-angular": "^20.3.0",
    "babel-core": "^7.0.0-0",
    "husky": "^9.1.7"
  },
  "dependencies": {
    "archiver": "^3.1.1",
    "camelcase": "^5.3.1",
    "chalk": "^3.0.0",
    "clui": "^0.3.6",
    "commander": "^5.0.0",
    "cross-spawn": "^7.0.1",
    "del": "^5.1.0",
    "download-git-repo": "^3.0.2",
    "fs-extra": "^9.0.0",
    "inquirer": "^7.1.0",
    "shelljs": "^0.8.3",
    "uuid": "^7.0.2",
    "yargs": "^15.3.1"
  }
}
